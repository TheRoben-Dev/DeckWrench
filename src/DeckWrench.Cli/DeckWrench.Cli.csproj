<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>deckwrench</AssemblyName>
    <!-- Windows file names ignore case: deckwrench.exe would clash with the app's DeckWrench.exe. -->
    <AssemblyName Condition="$(RuntimeIdentifier.StartsWith('win'))">deckwrench-cli</AssemblyName>
    <RootNamespace>DeckWrench.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeckWrench.Core\DeckWrench.Core.csproj" />
    <ProjectReference Include="..\DeckWrench.Host\DeckWrench.Host.csproj" />
  </ItemGroup>
</Project>
